{% extends 'sidebar.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
<div class="admin-dashboard">
    <!-- Header -->
    <div class="dashboard-header">
    <meta name="turbo-visit-control" content="reload">
        <h1 class="dashboard-title">{{ title|default('Admin Dashboard') }}</h1>
    </div>

    <!-- Stats Overview -->
    <div class="grid-stats">
        <div class="admin-stat-card">
            <h2 class="admin-stat-title">Total Users</h2>
            <p class="admin-stat-value">{{ totalUsers|default(0) }}</p>
        </div>
        
        <div class="admin-stat-card">
            <h2 class="admin-stat-title">Total Staff</h2>
            <p class="admin-stat-value">{{ totalStaff|default(0) }}</p>
        </div>
        
        <div class="admin-stat-card">
            <h2 class="admin-stat-title">Total Collectibles</h2>
            <p class="admin-stat-value">{{ totalCollectibles|default(0) }}</p>
        </div>
        
        <div class="admin-stat-card">
            <h2 class="admin-stat-title">Total Listings</h2>
            <p class="admin-stat-value">{{ totalListings|default(0) }}</p>
        </div>
        
        <div class="admin-stat-card">
            <h2 class="admin-stat-title">Total Listing Value</h2>
            <p class="admin-stat-value price-value">₱{{ totalValue|default(0)|number_format(2, '.', ',') }}</p>
        </div>
    </div>

    <!-- Recent Listings Table -->
    <div class="admin-table-container">
        <h2 class="admin-table-header">Recent Listings</h2>
        <div class="crud-table-wrapper">
            <div class="crud-table-scroll">
                <table id="recentListingsTable" class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Collectible</th>
                            <th>Price</th>
                            <th>Grade</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for listing in recentListings %}
                            <tr>
                                <td>#{{ listing.id }}</td>
                                <td>
                                    {% if listing.collectible %}
                                        {{ listing.collectible.name }}
                                    {% else %}
                                        <span class="text-gray-500 italic">Unknown</span>
                                    {% endif %}
                                </td>
                                <td class="price-value">₱{{ listing.price|number_format(2, '.', ',') }}</td>
                                <td>{{ listing.grade|default('N/A') }}</td>
                                <td>
                                    {% if listing.isForSale %}
                                        <span class="badge-success">For Sale</span>
                                    {% else %}
                                        <span class="badge-neutral">Not Listed</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Users Table -->
    <div class="admin-table-container">
        <h2 class="admin-table-header">Recent Users</h2>
        <div class="crud-table-wrapper">
            <div class="crud-table-scroll">
                <table id="recentUsersTable" class="admin-table">
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Role</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in recentUsers %}
                            <tr>
                                <td class="font-medium">{{ user.username }}</td>
                                <td>
                                    {% if 'ROLE_ADMIN' in user.roles %}
                                        <span class="badge-admin">Admin</span>
                                    {% elseif 'ROLE_STAFF' in user.roles %}
                                        <span class="badge-staff">Staff</span>
                                    {% else %}
                                        <span class="badge-user">User</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="admin-table-container">
        <h2 class="admin-table-header">Quick Stats</h2>
        <div class="quick-actions">
            <div class="admin-stat-card quick-action-card">
                <h2 class="admin-stat-title">Users</h2>
                <p class="admin-stat-value">{{ totalUsers|default(0) }}</p>
            </div>
            
            <div class="admin-stat-card quick-action-card">
                <h2 class="admin-stat-title">Collectibles</h2>
                <p class="admin-stat-value">{{ totalCollectibles|default(0) }}</p>
            </div>
            
            <div class="admin-stat-card quick-action-card">
                <h2 class="admin-stat-title">Listings</h2>
                <p class="admin-stat-value">{{ totalListings|default(0) }}</p>
            </div>
            
            <div class="admin-stat-card quick-action-card">
                <h2 class="admin-stat-title">Listing Value</h2>
                <p class="admin-stat-value price-value">₱{{ totalValue|default(0)|number_format(2, '.', ',') }}</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}