<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}My First Symfony Page{% endblock %}</title>

    {# 🎨 Load your global CSS (compiled via Webpack Encore) #}
    {{ encore_entry_link_tags('app') }}

    {# Optional: add fonts or other head content #}
    {% block stylesheets %}{% endblock %}
</head>

<body>
    {# 🧭 Navbar block - shared across all pages #}
    {% block navbar %}
        <nav>
            <a href="#">C O L L E C T I V</a>
            <a href="#">Home</a>
            <a href="#">Collection</a>
            <a href="#">Offers</a>
            <a href="#">Wishlisted</a>
        </nav>
    {% endblock %}

    {# 🧩 Main page content from child templates #}
    <main>
        {% block body %}{% endblock %}
    </main>

    {# ⚓ Footer block - shared across pages #}
    {% block footer %}
        <footer>
            &copy; 2025 Collectiv. All rights reserved.
        </footer>
    {% endblock %}

    {# 🧩 Load JS (also from Webpack Encore) #}
    {{ encore_entry_script_tags('app') }}

    {% block javascripts %}{% endblock %}
</body>
</html>
