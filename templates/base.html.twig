<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Collectiv{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('images/Collectiv-Logo.png') }}">
    
    {% block stylesheets %}
      {{ encore_entry_link_tags('app') }}
      <link rel="stylesheet" href="{{ asset('css/base-styles.css') }}">
    {% endblock %}
  </head>

  <body class="base-body" data-turbo-suppress-warning>
    {# --- NAVBAR --- #}
    <nav class="base-navbar">
      <div class="base-nav-logo-container">
        <img src="{{ asset('images/collectiv-logo.png') }}" alt="Collectiv Logo" class="base-nav-logo"/>
        <h1 class="base-nav-title">COLLECTIV</h1>
      </div>
      
      <ul class="base-nav-links">
        <li><a href="{{ path('home') }}" class="base-nav-link">Home</a></li>
        <li><a href="{{ path('explore') }}" class="base-nav-link">Explore</a></li>
        <li><a href="{{ path('collection') }}" class="base-nav-link">Profile</a></li>
        
        {# Admin Dashboard Link #}
        {% if is_granted('ROLE_ADMIN') %}
          <li><a href="{{ path('admin_dashboard') }}" class="base-admin-dashboard-link">Admin Dashboard</a></li>
        {% endif %}
        
        {# Staff Dashboard Link #}
        {% if is_granted('ROLE_STAFF') %}
          <li><a href="{{ path('admin_dashboard') }}" class="base-staff-dashboard-link">Staff Dashboard</a></li>
        {% endif %}
      </ul>
      
      {% if app.user %}
        {# User is logged in - show Logout #}
        <div class="base-user-section">
          <span class="base-welcome-text">Welcome, {{ app.user.username }}</span>
          <a href="{{ path('app_logout') }}" class="base-logout-button" data-turbo="false">
            Log Out
          </a>
        </div>
      {% else %}
        {# User is not logged in - show Login #}
        <a href="{{ path('app_login') }}" class="base-login-button">
          Log In
        </a>
      {% endif %}
    </nav>

    {# --- MAIN CONTENT --- #}
    <main class="base-main">
      {% block body %}{% endblock %}
    </main>

    {% block javascripts %}
      {{ encore_entry_script_tags('app') }}
    {% endblock %}
  </body>
</html>