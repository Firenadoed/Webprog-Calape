{% extends 'sidebar.html.twig' %}

{% block title %}Collectible Management{% endblock %}

{% block body %}
<div class="crud-page-container">
<meta name="turbo-visit-control" content="reload">
 <meta name="turbo-visit-control" content="reload">
    <meta name="turbo-cache-control" content="no-cache">
    <div class="crud-page-header">
        <h1 class="crud-page-title">Collectible Management</h1>
        
        <div class="crud-page-actions">
            <a href="{{ path('app_collectible_new') }}" class="crud-btn crud-btn-create">＋ New Collectible</a>
        </div>
    </div>

    {# === Collectibles Table === #}
    <div class="crud-table-wrapper">
        <div class="crud-table-scroll">
            <table id="collectibleManagementTable" class="crud-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th style="width: 80px;">Image</th>
                        <th style="width: 120px;">Name</th>
                        <th style="width: 100px;">Owner</th>
                        <th style="width: 100px;">Category</th>
                        <th style="width: 100px;">Franchise</th>
                        <th style="width: 240px;">Actions</th> <!-- Fixed width for actions -->
                    </tr>
                </thead>

                <tbody>
                    {% for collectible in collectibles %}
                    <tr>
                        <td>{{ collectible.id }}</td>
                        <td>
                            {% if collectible.image %}
                                <img src="{{ asset('uploads/collectibles/' ~ collectible.image) }}"
                                     alt="{{ collectible.name }}"
                                     class="crud-avatar">
                            {% else %}
                                <span class="text-gray-400">No Image</span>
                            {% endif %}
                        </td>
                        <td>{{ collectible.name }}</td>
                        <td>
                            {% if collectible.user %}
                                {% if collectible.user.getUsername() %}
                                    {{ collectible.user.getUsername() }}
                                {% else %}
                                    {{ collectible.user.getEmail() }}
                                {% endif %}
                            {% else %}
                                <span class="text-gray-400">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if collectible.category %}
                                <span class="category-badge">
                                    {{ collectible.category|capitalize }}
                                </span>
                            {% else %}
                                <span class="text-gray-400">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if collectible.franchise %}
                                {{ collectible.franchise }}
                            {% else %}
                                <span class="text-gray-400">—</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="crud-btn-group" style="display: flex; flex-wrap: nowrap; gap: 6px; align-items: center;">
                                {# View button - always enabled #}
                                <a href="{{ path('app_collectible_show', {'id': collectible.id}) }}"
                                   class="crud-btn crud-btn-secondary crud-btn-small">
                                    View
                                </a>
                                
                                {# Check if staff can edit/delete this collectible #}
                                {% set canEditDelete = is_granted('ROLE_ADMIN') or (is_granted('ROLE_STAFF') and collectible.createdBy and collectible.createdBy.id == app.user.id) %}
                                
                                {% if canEditDelete %}
                                    {# Staff can edit/delete their own collectibles, Admin can edit/delete all #}
                                    <a href="{{ path('app_collectible_edit', {'id': collectible.id}) }}"
                                       class="crud-btn crud-btn-secondary crud-btn-small">
                                        Edit
                                    </a>
                                    <form method="post" 
                                          action="{{ path('app_collectible_delete', {'id': collectible.id}) }}" 
                                          onsubmit="return confirm('Are you sure you want to delete this collectible? This action cannot be undone.');"
                                          style="display: inline-block; margin: 0; flex-shrink: 0;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ collectible.id) }}">
                                        <button type="submit" class="crud-btn crud-btn-danger crud-btn-small" style="padding: 4px 10px; font-size: 12px;">Delete</button>
                                    </form>
                                {% else %}
                                    {# Staff cannot edit/delete other staff's collectibles #}
                                    <button class="crud-btn crud-btn-secondary crud-btn-small" disabled 
                                            title="You can only edit collectibles created by you">
                                        Edit
                                    </button>
                                    <button class="crud-btn crud-btn-danger crud-btn-small" disabled 
                                            title="You can only delete collectibles created by you" 
                                            style="padding: 4px 10px; font-size: 12px;">
                                        Delete
                                    </button>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-8 text-gray-400">
                            No collectibles found.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}