{% extends 'sidebar.html.twig' %}

{% block title %}{{ collectible.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/show.css') }}">
{% endblock %}

{% block body %}
<div class="show-container">
    <div class="show-header">
        <h1>{{ collectible.name }}</h1>
        <div class="show-subtitle">
            {% if collectible.franchise %}
                From {{ collectible.franchise }}
            {% endif %}
            {% if collectible.category %}
                • {{ collectible.category|capitalize }}
            {% endif %}
        </div>
    </div>
    
    <div class="show-content">
        <!-- Left Column: Image -->
        <div class="show-image-section">
            {% if collectible.image %}
                <img src="{{ asset('uploads/collectibles/' ~ collectible.image) }}" 
                     alt="{{ collectible.name }}" 
                     class="show-main-image">
            {% else %}
                <div class="show-no-image">
                    📷 No Image Available
                </div>
            {% endif %}
            

        </div>
        
        <!-- Right Column: Information -->
        <div class="show-info-section">
            <div class="show-info-grid">
                <div class="show-info-item">
                    <div class="show-info-label">ID</div>
                    <div class="show-info-value">#{{ collectible.id }}</div>
                </div>
                
                <div class="show-info-item">
                    <div class="show-info-label">Name</div>
                    <div class="show-info-value">{{ collectible.name }}</div>
                </div>
                
                {% if collectible.category %}
                <div class="show-info-item">
                    <div class="show-info-label">Category</div>
                    <div class="show-info-value">
                        <span class="show-badge">{{ collectible.category|capitalize }}</span>
                    </div>
                </div>
                {% endif %}
                
                {% if collectible.franchise %}
                <div class="show-info-item">
                    <div class="show-info-label">Franchise</div>
                    <div class="show-info-value">{{ collectible.franchise }}</div>
                </div>
                {% endif %}
                
                {% if collectible.user %}
                <div class="show-info-item">
                    <div class="show-info-label">Owner</div>
                    <div class="show-owner-info">
                        {% if collectible.user.profileImage %}
                            <img src="{{ asset('uploads/profile/' ~ collectible.user.profileImage) }}" 
                                 alt="{{ collectible.user.username }}" 
                                 class="show-owner-avatar">
                        {% else %}
                            <div class="show-owner-avatar" style="background: #d4af37; display: flex; align-items: center; justify-content: center; color: #1a1a1a; font-weight: bold;">
                                {{ collectible.user.username|first|upper }}
                            </div>
                        {% endif %}
                        <div class="show-owner-details">
                            <h4>{{ collectible.user.username }}</h4>
                            <p>Collector since {{ collectible.user.createdAt ? collectible.user.createdAt|date('M Y') : 'N/A' }}</p>
                        </div>
                    </div>
                </div>
                {% endif %}
                
            </div>
            
            <!-- Action Buttons -->
            <div class="show-actions">
                <a href="{{ path('app_collectible_index') }}" class="show-btn show-btn-back" data-turbo="false">← Back to Collectibles</a>
                <a href="{{ path('app_collectible_edit', {'id': collectible.id}) }}" class="show-btn show-btn-edit" >✏️ Edit</a>
                
                <form method="post" action="{{ path('app_collectible_delete', {'id': collectible.id}) }}" 
                      onsubmit="return confirm('Are you sure you want to delete this collectible?');" 
                      style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ collectible.id) }}">
                    <button type="submit" class="show-btn show-btn-delete">🗑️ Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}