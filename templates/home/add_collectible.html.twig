{% extends 'base.html.twig' %}

{% block title %}Add Collectible{% endblock %}

{% block body %}
<section class="py-16 bg-[#1B1B1D] text-white">
  <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8">

    {# === Main Form === #}
    <div class="lg:col-span-2 bg-[#232327] p-8 rounded-2xl shadow-lg">
      <h2 class="text-3xl font-semibold text-[#d4af37] mb-8 text-center">Add New Collectible</h2>

      {{ form_start(form, {'attr': {'id': 'collectible-form'}}) }}
        <div class="space-y-6 text-left">
          {{ form_row(form.category) }}
          {{ form_row(form.franchise) }}

          <!-- Name field (auto-filled when fetched) -->
          <div class="relative">
            {{ form_row(form.name, {'attr': {'id': 'collectible_name', 'autocomplete': 'off'}}) }}
          </div>

          <!-- Description -->
          {{ form_row(form.description) }}

          <!-- Image field -->
          <div class="relative">
            <label class="block text-sm font-medium text-gray-300 mb-1">Image</label>

            <!-- Preview container -->
            <div id="image-preview-container" class="mb-3 hidden">
              <img id="preview-img" src="" alt="Card Preview"
                class="mx-auto rounded-lg shadow-md w-48 h-auto" />
            </div>

            <!-- Hidden input for API-fetched image -->
            <input type="hidden" id="fetched_image" name="fetched_image" />

            <!-- File input for user upload -->
            {{ form_widget(form.image, {'attr': {'id': 'collectible_image'}}) }}
            {{ form_errors(form.image) }}

            <!-- Error message for invalid file -->
            <p id="image-error" class="text-red-400 text-sm mt-1 hidden">
              Please upload a valid image file (jpg, jpeg, png, gif).
            </p>
          </div>

          <!-- Price -->
          <div class="relative">
            {{ form_row(form.price, {'attr': {'id': 'collectible_price', 'autocomplete': 'off'}}) }}
            <p id="price-error" class="text-red-400 text-sm mt-1 hidden">
              Please enter a valid number for price.
            </p>
          </div>
        </div>

        <button type="submit"
          class="mt-8 px-6 py-2 bg-[#d4af37] text-black font-semibold rounded-xl hover:bg-[#f5d26a] transition">
          Add Collectible
        </button>
      {{ form_end(form) }}
    </div>


    {# === Side Helper Card === #}
    <div class="bg-[#232327] p-6 rounded-2xl shadow-lg">
      <h3 class="text-xl font-semibold text-[#d4af37] mb-4">Do you know your Card ID?</h3>
      <p class="text-gray-300 text-sm mb-4">
        Enter a Pokémon TCG Card ID below to automatically fetch its name and image from TCGdex.
      </p>

      <input type="text" id="card-id" placeholder="e.g., swsh3-136"
        class="w-full mb-4 px-3 py-2 rounded-md bg-gray-800 text-white border border-gray-700 focus:ring-[#d4af37] focus:border-[#d4af37]" />

      {# 🔍 Link to internal Pokémon search page #}
      <p class="text-center mb-4">
        <a href="{{ path('pokesearch_trial') }}"
          class="text-[#d4af37] text-sm hover:underline hover:text-[#f5d26a] transition">
          🔍 Click here to search for your Pokémon Card ID
        </a>
      </p>

      <div class="flex items-center space-x-2 mb-4">
        <input type="checkbox" id="include-price" class="accent-[#d4af37]" />
        <label for="include-price" class="text-gray-300 text-sm">Include current market price</label>
      </div>

      <p class="text-yellow-400 text-xs mb-3 hidden" id="price-warning">
        ⚠️ Fetching price data may take up to a minute or may not be available.
      </p>

      <button id="fetch-card-btn"
        class="w-full bg-[#d4af37] text-black font-semibold py-2 rounded-md hover:bg-[#f5d26a] transition">
        Fetch Card Data
      </button>
    </div>

  </div>
</section>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector("#collectible-form");
    if (!form) return;

    const priceInput = document.querySelector("#collectible_price");
    const imageInput = document.querySelector("#collectible_image");
    const priceError = document.querySelector("#price-error");
    const imageError = document.querySelector("#image-error");
    const previewImg = document.querySelector("#preview-img");
    const previewContainer = document.querySelector("#image-preview-container");

    form.addEventListener("submit", (e) => {
      let isValid = true;

      // === Validate Price ===
      const priceValue = priceInput.value.trim();
      if (priceValue !== "" && isNaN(priceValue)) {
        priceError.classList.remove("hidden");
        priceInput.classList.add("border-red-500");
        isValid = false;
      } else {
        priceError.classList.add("hidden");
        priceInput.classList.remove("border-red-500");
      }

      // === Validate Image ===
      const file = imageInput.files[0];
      if (file) {
        const validTypes = ["image/jpeg", "image/png", "image/jpg", "image/gif"];
        if (!validTypes.includes(file.type)) {
          imageError.classList.remove("hidden");
          imageInput.classList.add("border-red-500");
          isValid = false;
        } else {
          imageError.classList.add("hidden");
          imageInput.classList.remove("border-red-500");
        }
      }

      if (!isValid) e.preventDefault();
    });

    // === Live Preview of Uploaded Image ===
    imageInput.addEventListener("change", (e) => {
      const file = e.target.files[0];
      if (file) {
        const validTypes = ["image/jpeg", "image/png", "image/jpg", "image/gif"];
        if (validTypes.includes(file.type)) {
          const reader = new FileReader();
          reader.onload = function(ev) {
            previewImg.src = ev.target.result;
            previewContainer.classList.remove("hidden");
          };
          reader.readAsDataURL(file);
        } else {
          previewContainer.classList.add("hidden");
        }
      } else {
        previewContainer.classList.add("hidden");
      }
    });
  });
  </script>
{% endblock %}
