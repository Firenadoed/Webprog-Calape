{% extends 'base.html.twig' %}

{% block title %}My Collection — Collectiv{% endblock %}

{% block body %}
<section class="bg-gradient-to-b from-[#1B1B1D] to-[#111113] min-h-screen text-gray-200 relative overflow-hidden">

  <!-- Background Glow -->
  <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_center,rgba(212,175,55,0.07),transparent_70%)]"></div>

  <!-- Profile Header -->
  <div class="relative w-full bg-gradient-to-r from-[#0e0e0f] via-[#141415] to-[#1B1B1D] border-b border-[#2a2a2d] shadow-lg">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center md:items-end justify-between p-8 md:p-12 gap-6">
      <div class="flex items-center gap-6">
        <div class="relative">
          <img src="{{ asset('uploads/profile/profile.jpg') }}" 
               alt="Profile Picture" 
               class="w-32 h-32 md:w-40 md:h-40 rounded-lg object-cover border-4 border-[#d4af37] shadow-[0_0_25px_rgba(212,175,55,0.3)]">
        </div>
        <div class="text-left">
          <h2 class="text-3xl md:text-4xl font-bold text-white drop-shadow-[0_0_10px_rgba(212,175,55,0.3)]">Rohan</h2>
          <p class="text-sm mt-2 text-gray-500">Joined January 2025 | {{ cards|length + figures|length + games|length + others|length }} Collectibles</p>
        </div>
      </div>
      <div class="flex flex-col items-center md:items-end">
        <div class="flex items-center gap-3">
          <div class="bg-[#d4af37] text-black font-bold text-sm px-4 py-2 rounded-full shadow-md">Level 15</div>
          <a href="{{ path('collection_add') }}" 
             class="bg-[#2a2a2d] text-[#d4af37] border border-[#d4af37]/50 hover:bg-[#d4af37] hover:text-black font-semibold px-4 py-2 rounded-md transition">
            Add Collectible
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Flash Messages -->
  <div id="flashContainer" class="max-w-7xl mx-auto px-8 mt-4"></div>

  {% set sections = {
    'cards': cards,
    'figures': figures,
    'games': games,
    'others': others
  } %}

  {% for key, items in sections %}
    <section class="py-5 text-center relative overflow-hidden">
      <h2 class="text-3xl font-semibold text-[#d4af37] mb-8 tracking-wide capitalize drop-shadow-[0_0_8px_rgba(212,175,55,0.5)]">
        Featured {{ key }}
      </h2>

      <div class="relative max-w-7xl mx-auto px-8 overflow-hidden">
        <button id="prevBtn-{{ key }}" class="absolute left-0 top-1/2 -translate-y-1/2 bg-black/60 text-[#d4af37] hover:bg-[#d4af37] hover:text-black transition p-3 rounded-full z-10">&#10094;</button>

        <div id="cardContainer-{{ key }}" class="flex justify-center gap-4 transition-transform duration-500 ease-out">
          {% for item in items %}
            <div class="card-float card-item w-[200px] h-[300px] bg-[#1F1F21] border border-[#2a2a2d] rounded-xl overflow-hidden shadow-md flex flex-col cursor-pointer"
                 data-id="{{ item.id }}"
                 data-listing-id="{{ listingMap[item.id] is defined ? listingMap[item.id] : '' }}"
                 data-name="{{ item.name }}"
                 data-description="{{ item.description }}"
                 data-image="{{ asset('uploads/collectibles/' ~ item.image) }}"
                 data-price="{{ item.price ?? '0.00' }}"
                 data-listed="{{ listingMap[item.id] is defined ? '1' : '0' }}"
                 data-delete-token="{{ listingMap[item.id] is defined ? csrf_token('delete' ~ listingMap[item.id]) : '' }}">
              <div class="h-[200px] w-full overflow-hidden flex items-center justify-center bg-[#141415]">
                <img src="{{ asset('uploads/collectibles/' ~ item.image) }}" alt="{{ item.name }}"
                     class="w-full h-full object-cover object-center transition duration-300 brightness-50">
              </div>
              <div class="flex-grow p-3 flex flex-col justify-between">
                <div>
                  <h3 class="text-base font-semibold text-[#d4af37] mb-1">{{ item.name }}</h3>
                  <p class="text-gray-400 text-xs leading-snug line-clamp-2">{{ item.description }}</p>
                </div>
                <p class="text-gray-500 text-[11px] mt-2 italic">Collectiv {{ key|capitalize }} Collection</p>
              </div>
            </div>
          {% else %}
            <p class="text-gray-500 italic mx-auto">No featured {{ key }} yet.</p>
          {% endfor %}
        </div>

        <button id="nextBtn-{{ key }}" class="absolute right-0 top-1/2 -translate-y-1/2 bg-black/60 text-[#d4af37] hover:bg-[#d4af37] hover:text-black transition p-3 rounded-full z-10">&#10095;</button>
      </div>

      {% if not loop.last %}
      <div class="w-1/3 mx-auto h-[1px] bg-gradient-to-r from-transparent via-[#d4af37]/80 to-transparent my-5"></div>
      {% endif %}
    </section>
  {% endfor %}
</section>

<!-- Modal -->
<div id="detailModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden z-50 flex items-center justify-center">
  <div class="bg-[#1f1f21] rounded-xl w-96 p-5 relative flex flex-col items-center max-h-[90vh] overflow-y-auto scale-0 transform transition-transform duration-300">
    <button id="modalClose" class="absolute top-2 right-2 text-gray-400 hover:text-[#d4af37] text-xl">&times;</button>
    <img id="modalImage" class="w-full h-64 object-cover rounded-md mb-4" src="" alt="Collectible Image">
    <h3 id="modalName" class="text-2xl font-bold text-[#d4af37] mb-2 text-center"></h3>
    <p id="modalDescription" class="text-gray-300 text-sm mb-4 text-center"></p>
    <p id="modalPrice" class="text-gray-400 text-xs mb-4 text-center">Base Price: <span class="font-bold text-[#d4af37]"></span></p>

    <form id="sellForm" method="POST" class="w-full flex flex-col items-center mt-4 space-y-3">
      <input type="hidden" name="collectible_id" id="modalCollectibleId">
      <input type="hidden" name="_token" id="modalToken" value="">

      <!-- PSA Grade Dropdown -->
      <div id="gradeWrapper" class="w-full flex flex-col items-center space-y-2">
        <label for="modalGrade" class="text-gray-300 text-sm font-medium">Select PSA Grade</label>
        <select id="modalGrade" name="grade" class="w-2/3 bg-[#141415] border border-[#d4af37]/40 text-gray-200 rounded-md px-3 py-2 focus:border-[#d4af37] focus:ring focus:ring-[#d4af37]/40 transition">
          <option value="">Unrated / Not Graded</option>
          <option value="10 - GEM-MT">10 - Gem Mint (GEM-MT)</option>
          <option value="9 - MINT">9 - Mint</option>
          <option value="8 - NM-MT">8 - Near Mint–Mint (NM-MT)</option>
          <option value="7 - NM">7 - Near Mint</option>
          <option value="6 - EX-MT">6 - Excellent–Mint (EX-MT)</option>
          <option value="5 - EX">5 - Excellent</option>
          <option value="4 - VG-EX">4 - Very Good–Excellent</option>
          <option value="3 - VG">3 - Very Good</option>
          <option value="2 - GOOD">2 - Good</option>
          <option value="1 - POOR">1 - Poor</option>
        </select>
      </div>

      <!-- Submit Button -->
      <button id="sellButton" type="submit" class="bg-[#d4af37] text-black px-5 py-2 rounded-md font-semibold hover:bg-[#f0cf57] transition">
        Put Up for Sale
      </button>

      <!-- Edit Button -->
      <a id="editButton" href="#" class="hidden bg-[#2a2a2d] text-[#d4af37] border border-[#d4af37]/40 px-5 py-2 rounded-md font-semibold hover:bg-[#d4af37] hover:text-black transition text-center w-2/3">
        Edit Collectible
      </a>
    </form>
  </div>
</div>

<style>
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
.card-float { animation: float 4s ease-in-out infinite; }
.scale-90 { transform: scale(0.9); }
.scale-105 { transform: scale(1.05); }
.brightness-50 { filter: brightness(0.5); }
.brightness-100 { filter: brightness(1); }
</style>

<script>
function initCollectionPage() {
  if (window.collectionPageInitialized) return;
  window.collectionPageInitialized = true;

  ['cards','figures','games','others'].forEach(key => {
    const container = document.getElementById(`cardContainer-${key}`);
    if (!container) return;
    const cards = Array.from(container.querySelectorAll('.card-item'));
    const prevBtn = document.getElementById(`prevBtn-${key}`);
    const nextBtn = document.getElementById(`nextBtn-${key}`);
    const cardWidth = 220;
    let index = 0;

    const updateCards = () => {
      const total = cards.length;
      if(total === 0) return;
      if(index < 0) index = total - 1;
      if(index >= total) index = 0;
      const containerWidth = container.offsetWidth;
      const visibleCards = Math.floor(containerWidth / cardWidth);
      const offset = ((visibleCards - 1) / 2) * cardWidth;
      container.style.transform = `translateX(-${index * cardWidth - offset}px)`;
      cards.forEach(card => { card.classList.remove('scale-105','brightness-100'); card.classList.add('scale-90','brightness-50'); });
      cards[index].classList.remove('scale-90','brightness-50');
      cards[index].classList.add('scale-105','brightness-100');
    };

    nextBtn?.addEventListener('click', () => { index++; updateCards(); });
    prevBtn?.addEventListener('click', () => { index--; updateCards(); });
    cards.forEach((card, i) => card.addEventListener('click', () => { index = i; updateCards(); }));
    updateCards();
    window.addEventListener('resize', updateCards);
  });

  const modal = document.getElementById('detailModal');
  if(!modal) return;
  const modalContent = modal.querySelector('div');
  const modalImage = document.getElementById('modalImage');
  const modalName = document.getElementById('modalName');
  const modalDescription = document.getElementById('modalDescription');
  const modalPrice = document.querySelector('#modalPrice span');
  const modalCollectibleIdInput = document.getElementById('modalCollectibleId');
  const sellButton = document.getElementById('sellButton');
  const modalToken = document.getElementById('modalToken');
  const editButton = document.getElementById('editButton');
  const closeBtn = document.getElementById('modalClose');

  document.querySelectorAll('.card-item').forEach(card => {
    card.addEventListener('dblclick', () => {
      const isListed = card.dataset.listed === '1';
      modal.classList.remove('hidden');
      setTimeout(()=>modalContent.classList.add('scale-100'),10);

      modalImage.src = card.dataset.image;
      modalName.textContent = card.dataset.name;
      modalDescription.textContent = card.dataset.description;
      modalPrice.textContent = `$${parseFloat(card.dataset.price).toFixed(2)}`;
      modalCollectibleIdInput.value = card.dataset.id;

      // Update form + visibility
      sellButton.textContent = isListed ? 'Take Out of Sale' : 'Put Up for Sale';
      document.getElementById('gradeWrapper').style.display = isListed ? 'none' : 'flex';
      editButton.classList.toggle('hidden', isListed);
      editButton.href = `/collection/${card.dataset.id}/edit`;

      sellButton.form.action = isListed
        ? `/listing/delete/${card.dataset.listingId}`
        : `{{ path('listing_add') }}`;
      modalToken.value = isListed
        ? card.dataset.deleteToken
        : '{{ csrf_token('add_listing_' ~ 'PLACEHOLDER') }}'.replace('PLACEHOLDER', card.dataset.id);
    });
  });

  function closeModal(){
    modalContent.classList.remove('scale-100');
    setTimeout(()=>modal.classList.add('hidden'),200);
  }
  closeBtn.addEventListener('click',closeModal);
  modal.addEventListener('click', e=>{ if(e.target===modal) closeModal(); });
  document.addEventListener('keydown', e=>{ if(e.key==='Escape') closeModal(); });

  const sellForm = document.getElementById('sellForm');
  if(sellForm){
    sellForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const collectibleId = modalCollectibleIdInput.value;
      const token = modalToken.value;
      const grade = document.getElementById('modalGrade').value;
      const actionUrl = sellButton.form.action;

      fetch(actionUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({
          collectible_id: collectibleId,
          grade: grade,
          _token: token
        })
      })
      .then(res => res.json())
      .then(data => {
        const flashContainer = document.getElementById('flashContainer');
        const flash = document.createElement('div');
        flash.className = `p-3 rounded-md mb-2 text-white ${
          data.status === 'success' ? 'bg-green-600' :
          data.status === 'error' ? 'bg-red-600' : 'bg-yellow-500 text-black'}`;
        flash.textContent = data.message;
        flashContainer.prepend(flash);
        setTimeout(()=>flash.remove(),4000);

        closeModal();

        const card = document.querySelector(`.card-item[data-id='${collectibleId}']`);
        if(card) {
          if(card.dataset.listed === '0' && data.listingId){
            card.dataset.listed = '1';
            card.dataset.listingId = data.listingId;
            card.dataset.deleteToken = data.deleteToken;
          } else {
            card.dataset.listed = '0';
            card.dataset.listingId = '';
            card.dataset.deleteToken = '';
          }
        }
      });
    });
  }
}

document.addEventListener('DOMContentLoaded', initCollectionPage);
document.addEventListener('turbo:load', initCollectionPage);
</script>
{% endblock %}
