{% extends 'base.html.twig' %}

{% block title %}My Collection — Collectiv{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/collection.css') }}">
{% endblock %}

{% block body %}
<section class="collection-page">
  <div class="collection-bg"></div>

  <!-- Profile Section -->
  <div class="collection-profile-section">
    <div class="collection-profile-container">
      <div class="collection-profile-info">
        <div class="collection-profile-image-wrapper">
          <img src="{{ asset('uploads/profile/' ~ app.user.profileImage) }}" 
               alt="Profile Picture" 
               class="collection-profile-image">
        </div>
        <div class="collection-profile-details">
          <h2 class="collection-profile-name">{{ app.user.username }}</h2>
          <p class="collection-profile-meta">
            Joined {{ app.user.createdAt|date('F Y') }} | 
            {{ cards|length + figures|length + games|length + artworks|length + others|length }} Collectibles
          </p>
          {% if app.user.bio %}
          <p class="collection-profile-bio">{{ app.user.bio }}</p>
          {% endif %}
        </div>
      </div>
      <div class="collection-profile-actions">
        <div class="collection-action-buttons">
          <div class="collection-level-badge">
            {% if 'ROLE_ADMIN' in app.user.roles %}
              Admin
            {% elseif 'ROLE_STAFF' in app.user.roles %}
              Staff
            {% else %}
              Collector
            {% endif %}
          </div>
          
          <!-- MY LISTINGS BUTTON - ADDED HERE -->
          <a href="{{ path('my_listings') }}" class="collection-listings-button">
            My Listings
            {% if my_listings is defined and my_listings|length > 0 %}
              <span class="collection-listings-count">({{ my_listings|length }})</span>
            {% endif %}
          </a>
          
          <a href="{{ path('collection_add') }}" class="collection-add-button">
            Add Collectible
          </a>
          <!-- EDIT PROFILE BUTTON ADDED HERE -->
          <button id="openProfileEditModal" class="collection-edit-profile-button">
            Edit Profile
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Flash Messages -->
  <div id="collectionFlashContainer" class="collection-flash-container"></div>

  <!-- Collectible Display -->
  {% set sectionNames = ['cards', 'figures', 'games', 'artworks'] %}
  
  {% for sectionName in sectionNames %}
    {% set items = attribute(_context, sectionName) %}
    <section class="collection-section">
      <h2 class="collection-section-title">
        {{ sectionName|capitalize }} Collection
      </h2>

      <div class="collection-carousel-container">
        <button id="collectionPrevBtn-{{ sectionName }}" class="collection-carousel-btn collection-carousel-prev">&#10094;</button>

        <div id="collectionCardContainer-{{ sectionName }}" class="collection-carousel-track">
          {% for item in items %}
            <div class="collection-collectible-card collection-card-float"
                 data-id="{{ item.id }}"
                 data-listed="{{ listingMap[item.id] is defined ? '1' : '0' }}"
                 data-listing-id="{{ listingMap[item.id] is defined ? listingMap[item.id] : '' }}"
                 data-name="{{ item.name }}"
                 data-description="{{ item.description }}"
                 data-image="{{ asset('uploads/collectibles/' ~ item.image) }}"
                 data-price="{{ item.price ?? '0.00' }}"
                 data-franchise="{{ item.franchise }}"
                 data-category="{{ item.category }}"
                 data-delete-collectible-token="{{ csrf_token('delete' ~ item.id) }}"
                 {% if listingMap[item.id] is defined %}
                 data-delete-listing-token="{{ csrf_token('delete' ~ listingMap[item.id]) }}"
                 {% endif %}>
              <div class="collection-card-image-container">
                <img src="{{ asset('uploads/collectibles/' ~ item.image) }}" alt="{{ item.name }}"
                     class="collection-card-image">
              </div>
              <div class="collection-card-content">
                <div>
                  <h3 class="collection-card-title">{{ item.name }}</h3>
                  <p class="collection-card-description">{{ item.description|slice(0, 100) }}{% if item.description|length > 100 %}...{% endif %}</p>
                </div>
                <p class="collection-card-category">{{ item.franchise }} • {{ item.category }}</p>
                {% if listingMap[item.id] is defined %}
                <div class="collection-listed-badge">Listed for Sale</div>
                {% endif %}
              </div>
            </div>
          {% else %}
            <div class="collection-empty-section">
              <p>No {{ sectionName }} in your collection yet.</p>
              <a href="{{ path('collection_add') }}" class="collection-empty-add-button">
                Add Your First {{ sectionName|slice(0, -1)|capitalize }}
              </a>
            </div>
          {% endfor %}
        </div>

        <button id="collectionNextBtn-{{ sectionName }}" class="collection-carousel-btn collection-carousel-next">&#10095;</button>
      </div>

      {% if not loop.last %}
      <div class="collection-section-divider"></div>
      {% endif %}
    </section>
  {% endfor %}
</section>

<!-- Modal when dblclick Display -->
<div id="collectionDetailModal" class="collection-modal">
  <div class="collection-modal-container">
    <div class="collection-modal-image-container">
      <img id="collectionModalImage" class="collection-modal-image" src="" alt="Collectible Image">
    </div>

    <div class="collection-modal-content">
      <button id="collectionModalClose" class="collection-modal-close">&times;</button>
      <div>
        <h3 id="collectionModalName" class="collection-modal-title"></h3>
        <p id="collectionModalDescription" class="collection-modal-description"></p>
        <p id="collectionModalFranchise" class="collection-modal-meta"></p>
        <p id="collectionModalCategory" class="collection-modal-meta"></p>
        <p id="collectionModalPrice" class="collection-modal-price">Base Price: <span class="collection-modal-price-value"></span></p>
     </div>

    <form id="collectionSellForm" method="POST" class="collection-modal-form">
  <input type="hidden" name="collectible_id" id="collectionModalCollectibleId">
  <input type="hidden" name="_token" id="collectionModalToken" value="">

  <div id="collectionGradeWrapper" class="collection-grade-wrapper">
    <label for="collectionModalGrade" class="collection-grade-label">Select PSA Grade</label>
    <select id="collectionModalGrade" name="grade" class="collection-grade-select">
      <option value="">Unrated / Not Graded</option>
      <option value="10 - GEM-MT">10 - Gem Mint (GEM-MT)</option>
      <option value="9 - MINT">9 - Mint</option>
      <option value="8 - NM-MT">8 - Near Mint–Mint (NM-MT)</option>
      <option value="7 - NM">7 - Near Mint</option>
      <option value="6 - EX-MT">6 - Excellent–Mint (EX-MT)</option>
      <option value="5 - EX">5 - Excellent</option>
      <option value="4 - VG-EX">4 - Very Good–Excellent</option>
      <option value="3 - VG">3 - Very Good</option>
      <option value="2 - GOOD">2 - Good</option>
      <option value="1 - POOR">1 - Poor</option>
    </select>
  </div>

  <!-- ADD THIS PRICE INPUT SECTION -->
  <div id="collectionPriceWrapper" class="collection-price-wrapper" style="display: none;">
    <label for="collectionModalPriceInput" class="collection-price-label">Sale Price (₱)</label>
    <input 
      type="number" 
      id="collectionModalPriceInput" 
      name="price" 
      min="1" 
      step="0.01" 
      placeholder="0.00"
      class="collection-price-input"
    >
    <small class="collection-price-help">Minimum price: ₱1.00</small>
  </div>

  <div class="collection-modal-actions">
    <button id="collectionSellButton" type="submit" class="collection-sell-button">
      Put Up for Sale
    </button>
    <button id="collectionDeleteButton" type="button" class="collection-delete-button">
      Delete
    </button>
  </div>

  <a id="collectionEditButton" href="#" class="collection-edit-button">
    Edit Collectible
  </a>
</form>
    </div>
  </div>
</div>

<!-- Profile Edit Modal -->
<div id="profileEditModal" class="profile-edit-modal" style="display: none;">
  <div class="profile-edit-modal-container">
    <div class="profile-edit-modal-content">
      <button id="profileEditModalClose" class="profile-edit-modal-close">&times;</button>
      <h3 class="profile-edit-modal-title">Edit Profile</h3>
      
      <form id="profileEditForm" method="POST" class="profile-edit-form">
        <input type="hidden" name="_token" value="{{ csrf_token('profile_edit') }}">
        
        <div class="profile-edit-tabs">
          <button type="button" class="profile-edit-tab active" data-tab="profile-info">Profile Info</button>
          <button type="button" class="profile-edit-tab" data-tab="change-password">Change Password</button>
        </div>
        
        <!-- Profile Info Tab -->
        <div id="profile-info-tab" class="profile-edit-tab-content active">
          <div class="profile-edit-form-group">
            <label for="profileUsername">Username</label>
            <input type="text" id="profileUsername" name="username" 
                   value="{{ app.user.username }}" class="profile-edit-input" required>
          </div>
          
          <div class="profile-edit-form-group">
            <label for="profileBio">Bio</label>
            <textarea id="profileBio" name="bio" class="profile-edit-textarea" rows="4">{{ app.user.bio }}</textarea>
            <small class="profile-edit-help-text">Max 500 characters</small>
          </div>
          
          <div class="profile-edit-form-group">
            <div class="current-profile-image-container">
              <p>Current Profile Image:</p>
              <img src="{{ asset('uploads/profile/' ~ app.user.profileImage) }}" 
                   alt="Current Profile Picture" 
                   class="current-profile-image-preview">
            </div>
            
            <label for="profileImage">Upload New Image</label>
            <input type="file" id="profileImage" name="profileImage" accept="image/*" class="profile-edit-file-input">
            <small class="profile-edit-help-text">Max file size: 2MB. Supported formats: JPG, PNG, GIF, WebP</small>
          </div>
        </div>
        
        <!-- Change Password Tab -->
        <div id="change-password-tab" class="profile-edit-tab-content">
          <div class="profile-edit-form-group">
            <label for="currentPassword">Current Password</label>
            <input type="password" id="currentPassword" name="currentPassword" class="profile-edit-input" 
                   placeholder="Enter your current password">
            <small class="profile-edit-help-text">Required to change your password</small>
          </div>
          
          <div class="profile-edit-form-group">
            <label for="newPassword">New Password</label>
            <input type="password" id="newPassword" name="newPassword" class="profile-edit-input" 
                   placeholder="Enter new password">
            <small class="profile-edit-help-text">At least 8 characters with letters and numbers</small>
          </div>
          
          <div class="profile-edit-form-group">
            <label for="confirmPassword">Confirm New Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" class="profile-edit-input" 
                   placeholder="Confirm new password">
            <small class="profile-edit-help-text">Must match the new password</small>
          </div>
          
          <div class="password-strength-meter">
            <div class="password-strength-bar"></div>
            <div class="password-strength-text"></div>
          </div>
        </div>
        
        <div class="profile-edit-modal-actions">
          <button type="submit" class="profile-edit-save-button">Save Changes</button>
          <button type="button" id="profileEditCancelButton" class="profile-edit-cancel-button">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
window.collectionData = {
  listingAddPath: "{{ path('listing_add') }}",
  listingDeletePath: "my-collection/listing/delete/__ID__",
  sections: {{ ['cards', 'figures', 'games', 'artworks']|json_encode|raw }},
  currentUser: {
    id: {{ app.user.id }},
    username: "{{ app.user.username }}",
    role: {{ app.user.roles|json_encode|raw }},
    profileImage: "{{ app.user.profileImage }}"
  }
};
</script>
{% endblock %}