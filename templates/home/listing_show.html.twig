{% extends 'base.html.twig' %}

{% block title %}{{ listing.collectible.name }} — Collectiv{% endblock %}

{% block body %}
<section class="py-16 bg-[#1B1B1D] text-white">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10">
        {# --- Product Image --- #}
        <div>
            <img src="{{ asset('uploads/collectibles/' ~ listing.collectible.image) }}" 
                 alt="{{ listing.collectible.name }}" 
                 class="w-full h-auto rounded-lg shadow-lg object-cover">
        </div>

        {# --- Product Details --- #}
        <div class="flex flex-col justify-between">
            <div>
                <h1 class="text-4xl font-bold text-[#d4af37] mb-4">{{ listing.collectible.name }}</h1>
                <p class="text-gray-300 mb-4">{{ listing.collectible.description }}</p>

                <div class="text-2xl font-semibold text-[#d4af37] mb-6">
                    ${{ listing.price }}
                </div>

                <div class="space-x-4">
                    <button class="bg-[#d4af37] text-black font-semibold px-6 py-3 rounded-lg hover:bg-[#c19b2f] transition">
                        Buy Now
                    </button>
                    <button class="border border-[#d4af37] text-[#d4af37] font-semibold px-6 py-3 rounded-lg hover:bg-[#d4af37] hover:text-black transition">
                        Add to Cart
                    </button>
                </div>

                {# Optional: Additional info like condition, category #}
                <div class="mt-6 text-gray-400">
                    <p>Category: {{ listing.collectible.category.name }}</p>
                    <p>Condition: {{ listing.grade ?: 'N/A' }}</p>
                    <p>Seller: {{  'Unknown' }}</p>
                </div>
            </div>

            {# Optional: Related products could go here #}
        </div>
    </div>
</section>
{% endblock %}
