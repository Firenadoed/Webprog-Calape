{% extends 'base.html.twig' %}

{% block title %}Collectiv — Where Collectors Belong{% endblock %}

{% block body %}
<section 
  class="relative w-full h-screen flex items-center justify-center text-center overflow-hidden bg-[#1B1B1D]">
  

  <img 
    src="{{ asset('images/home-banner.jpg') }}" 
    alt="Collectiv Hero"
    class="absolute inset-0 w-full h-full object-cover opacity-90"
  >


  <div class="absolute inset-0 bg-gradient-to-t from-[#1B1B1D] via-[#1B1B1D]/60 to-transparent"></div>


  <div class="relative z-10 text-white px-6">
    <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-widest text-[#d4af37] drop-shadow-[0_0_10px_#d4af37]">
      COLLECTIV
    </h1>
    <p class="text-lg md:text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
      “Where Collectors Belong” — Discover. Showcase. Connect.
    </p>
    <a href="{{ path('explore') }}" 
       class="bg-[#d4af37] text-black px-8 py-3 rounded-md font-semibold text-lg hover:bg-[#c19b2f] hover:scale-105 transition-all duration-300 shadow-[0_0_25px_rgba(212,175,55,0.4)]">
      Explore
    </a>
  </div>

</section>


{# --- Secondary Section: Featured Collectibles --- #}
<section class="py-20 bg-[#141415] border-t border-[#2a2a2d] text-center">
  <h2 class="text-3xl font-semibold text-[#d4af37] tracking-wide mb-10">Featured Collectibles</h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 px-6 md:px-12">
    {% set collectibles = [
      {'title': 'Cards', 'image': 'collectibles-cards/Cards.jpg', 'desc': 'Discover rare Pokémon, Yu-Gi-Oh!, and more.'},
      {'title': 'Figures', 'image': 'collectibles-cards/Figures.jpg', 'desc': 'Explore collectible figures and statues from your favorite universes.'},
      {'title': 'Games', 'image': 'collectibles-cards/Games.jpg', 'desc': 'Classic cartridges, limited editions, and modern treasures.'},
      {'title': 'Artworks', 'image': 'collectibles-cards/Artwork.jpg', 'desc': 'Fan-made and official artwork collectibles with timeless value.'}
    ] %}

    {% for item in collectibles %}
    {% set category_slug = item.title %} {# Use exact category name as in DB #}
    <div class="group relative bg-[#1F1F21] border border-[#2a2a2d] rounded-xl overflow-hidden 
                hover:shadow-[0_0_40px_rgba(212,175,55,0.5)] hover:scale-[1.05] transition duration-300">
        <img src="{{ asset('images/' ~ item.image) }}" alt="{{ item.title }}" 
             class="w-full h-56 object-cover opacity-90 group-hover:opacity-100 transition">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm opacity-0 group-hover:opacity-100 
                    transition duration-300 flex flex-col justify-center items-center px-4 text-center">
            <p class="text-[#d4af37] font-semibold text-lg mb-2">{{ item.title }}</p>
            <p class="text-gray-300 text-sm mb-4">{{ item.desc }}</p>
            <a href="{{ path('explore', {'category': category_slug}) }}" 
               class="text-sm text-white border border-[#d4af37] px-4 py-2 rounded-md 
                      hover:bg-[#d4af37] hover:text-black transition">
                View {{ item.title }}
            </a>
        </div>
    </div>
{% endfor %}
  </div>
</section>


<section class="py-20 bg-[#1B1B1D] text-center border-t border-[#2a2a2d]">
  <h3 class="text-3xl font-semibold text-[#d4af37] mb-6">Join the Collectiv</h3>
  <p class="text-gray-400 mb-8 max-w-2xl mx-auto">
    Showcase your rare finds, build your collection, and connect with collectors across the world.
  </p>
  <a href="{{ path('collection') }}" class="bg-[#d4af37] text-black font-semibold px-8 py-3 rounded-md hover:bg-[#c19b2f] transition">
    Get Started
  </a>
</section>
{% endblock %}
