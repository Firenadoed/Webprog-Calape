{% extends 'admin/base-admin.html.twig' %}

{% block title %}Category Management{% endblock %}

{% block body %}
<div class="px-0 sm:px-0 lg:px-0">

    <h1 class="text-3xl font-bold text-[#d4af37] mb-6 text-center">Category Management</h1>


    {# === Category Table === #}
    <div class="overflow-x-auto border border-gray-700 rounded-md shadow-lg">
        <div class="max-h-[calc(80vh-180px)] overflow-y-auto">
            <table class="min-w-full divide-y divide-gray-700">
                <thead class="bg-gray-800 sticky top-0 z-10">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Description</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-gray-900 divide-y divide-gray-700">
                    {% for category in categories %}
                    <tr class="hover:bg-gray-800 transition">
                        <td class="px-6 py-4 whitespace-nowrap">{{ category.id }}</td>
                        <td class="px-6 py-4 whitespace-nowrap font-semibold text-[#d4af37]">{{ category.name }}</td>
                        <td class="px-6 py-4">
                            {{ category.description|length > 50 ? category.description|slice(0,50) ~ '...' : category.description }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap flex flex-col sm:flex-row gap-1">
                            <button
                                class="px-3 py-1 bg-[#d4af37] text-gray-900 font-semibold rounded-md hover:bg-yellow-400 transition"
                                data-modal-target="modal-{{ category.id }}">
                                Show
                            </button>
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}"
                               class="px-3 py-1 bg-[#d4af37] text-gray-900 font-semibold rounded-md hover:bg-yellow-400 transition">
                               Edit
                            </a>
                        </td>
                    </tr>

                    {# === Modal for Each Category === #}
                    <div id="modal-{{ category.id }}" class="fixed inset-0 bg-black bg-opacity-60 hidden flex items-center justify-center z-50 overflow-auto">
                        <div class="bg-gray-900 p-6 rounded-md w-96 relative max-h-[90vh] overflow-auto border-2 border-[#d4af37] shadow-lg">
                            <span class="absolute top-2 right-3 cursor-pointer text-[#d4af37]" onclick="document.getElementById('modal-{{ category.id }}').classList.add('hidden')">✕</span>

                            <h2 class="text-xl font-bold text-[#d4af37] mb-2 text-center">{{ category.name }}</h2>

                            <div class="text-gray-300 mb-4">
                                <p class="text-gray-400 mb-1 font-semibold">ID:</p>
                                <p class="mb-2">{{ category.id }}</p>

                                <p class="text-gray-400 mb-1 font-semibold">Description:</p>
                                <p>{{ category.description ?: 'No description available.' }}</p>
                            </div>

                            <div class="flex justify-between mt-4 gap-2">
                                <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="px-3 py-1 bg-[#d4af37] text-gray-900 rounded hover:bg-yellow-400 font-semibold">Edit</a>
                                {{ include('category/_delete_form.html.twig', {'category': category}) }}
                            </div>
                        </div>
                    </div>

                    {% else %}
                    <tr>
                        <td colspan="4" class="px-6 py-4 text-center text-gray-400">No categories found</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-6 text-center">
        <a href="{{ path('app_category_new') }}"
           class="inline-block px-6 py-3 bg-[#d4af37] text-gray-900 font-bold rounded-lg hover:bg-yellow-400 transition">
            ＋ Create New Category
        </a>
    </div>
</div>

{# === JS for Modals === #}
<script>
document.querySelectorAll('button[data-modal-target]').forEach(btn => {
    btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-modal-target');
        document.getElementById(target).classList.remove('hidden');
    });
});
</script>
{% endblock %}
