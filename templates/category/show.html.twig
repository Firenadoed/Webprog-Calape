{% extends 'admin/base-admin.html.twig' %}

{% block title %}Category Details{% endblock %}

{% block body %}
{# Modal Background Overlay #}
<div id="category-modal" class="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50">

    {# Modal Box #}
    <div class="bg-gray-900 border-2 border-[#d4af37] rounded-lg shadow-lg w-full max-w-md p-6 relative">

        {# Close Button #}
        <a href="{{ path('app_category_index') }}" class="absolute top-3 right-3 text-[#d4af37] hover:text-yellow-400 text-xl font-bold">&times;</a>

        <h2 class="text-center text-2xl font-bold text-[#d4af37] mb-4">{{ category.name }}</h2>

        <div class="space-y-3 text-white">
            {# ID #}
            <div class="flex justify-between border-b border-gray-700 pb-1">
                <span class="font-semibold text-[#d4af37]">ID:</span>
                <span>{{ category.id }}</span>
            </div>

            {# Name #}
            <div class="flex justify-between border-b border-gray-700 pb-1">
                <span class="font-semibold text-[#d4af37]">Name:</span>
                <span>{{ category.name }}</span>
            </div>

            {# Description #}
            <div class="flex justify-between border-b border-gray-700 pb-1">
                <span class="font-semibold text-[#d4af37]">Description:</span>
                <span>{{ category.description ?: 'No Description' }}</span>
            </div>
        </div>

        {# Action Buttons #}
        <div class="mt-6 flex justify-between gap-2">
            <a href="{{ path('app_category_index') }}" class="flex-1 bg-gray-800 text-[#d4af37] py-2 rounded hover:bg-gray-700 text-center">Back</a>
            <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="flex-1 bg-[#d4af37] text-gray-900 py-2 rounded hover:bg-yellow-400 text-center">Edit</a>
            {{ include('category/_delete_form.html.twig', { 'attr': {'class':'flex-1 bg-red-600 text-white py-2 rounded hover:bg-red-700 text-center'} }) }}
        </div>
    </div>
</div>
{% endblock %}
