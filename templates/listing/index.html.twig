{% extends 'admin/base-admin.html.twig' %}

{% block title %}Listings Management{% endblock %}

{% block body %}
<div class="px-0 sm:px-0 lg:px-0">
    <h1 class="text-3xl font-bold text-[#d4af37] mb-6 text-center">Listings Management</h1>

    {# === Filter & Search === #}
    <div class="flex flex-col sm:flex-row items-center justify-between mb-6 space-y-3 sm:space-y-0 sm:space-x-3">
        <form method="GET" action="{{ path('app_listing_index') }}" class="w-full sm:w-1/2 flex-grow sm:flex-grow-0 sm:mr-auto">
            <label for="search" class="sr-only">Search Listings</label>
            <input type="search"
                   name="search"
                   id="search"
                   value="{{ app.request.query.get('search') }}"
                   placeholder="Search by grade, user, or collectible..."
                   class="text-white bg-gray-800 border border-gray-700 focus:border-[#d4af37] focus:ring focus:ring-[#d4af37] focus:ring-opacity-50 rounded-md shadow-sm block w-full px-3 py-1.5 text-sm">
        </form>

        <form method="GET" action="{{ path('app_listing_index') }}" class="w-full sm:w-1/2 flex items-center justify-end sm:ml-auto">
            <label for="filter" class="sr-only">Filter by Status</label>
            <select name="filter"
                    id="filter"
                    onchange="this.form.submit()"
                    class="text-white bg-gray-800 border border-gray-700 focus:border-[#d4af37] focus:ring focus:ring-[#d4af37] focus:ring-opacity-50 rounded-md shadow-sm block w-full py-1.5 pl-3 pr-10 text-sm">
                <option value="">All Listings</option>
                <option value="for_sale" {% if app.request.query.get('filter') == 'for_sale' %}selected{% endif %}>For Sale</option>
                <option value="shop_item" {% if app.request.query.get('filter') == 'shop_item' %}selected{% endif %}>Shop Items</option>
            </select>
        </form>
    </div>
    {# === End Filter & Search === #}

    {# === Listings Table === #}
    <div class="overflow-x-auto border border-gray-700 rounded-md shadow-lg">
        <div class="max-h-[calc(80vh-180px)] overflow-y-auto">
            <table class="min-w-full divide-y divide-gray-700">
                <thead class="bg-gray-800 sticky top-0 z-10">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">User</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Collectible</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Grade</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Price</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">For Sale</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Shop Item</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Created</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>

                <tbody class="bg-gray-900 divide-y divide-gray-700">
                    {% for listing in listings %}
                        <tr class="hover:bg-gray-800 transition">
                            <td class="px-6 py-4 whitespace-nowrap">{{ listing.id }}</td>
                            <td class="px-6 py-4 whitespace-nowrap">{{ listing.user.username ?? 'Unknown' }}</td>
                            <td class="px-6 py-4 whitespace-nowrap">{{ listing.collectible.name ?? 'Unknown' }}</td>
                            <td class="px-6 py-4 whitespace-nowrap">{{ listing.grade ?? 'N/A' }}</td>
                            <td class="px-6 py-4 whitespace-nowrap font-semibold">₱{{ listing.price|number_format(2, '.', ',') }}</td>

                            {# Status badges #}
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if listing.isForSale %}
                                    <span class="inline-block px-2 py-1 text-xs font-semibold text-green-900 bg-green-300 rounded-full">For Sale</span>
                                {% else %}
                                    <span class="inline-block px-2 py-1 text-xs font-semibold text-gray-400 bg-gray-700 rounded-full">Not Listed</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if listing.isShopItem %}
                                    <span class="inline-block px-2 py-1 text-xs font-semibold text-blue-900 bg-blue-300 rounded-full">Shop</span>
                                {% else %}
                                    <span class="inline-block px-2 py-1 text-xs font-semibold text-gray-400 bg-gray-700 rounded-full">No</span>
                                {% endif %}
                            </td>

                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400">
                                {{ listing.createdAt ? listing.createdAt|date('Y-m-d H:i') : 'N/A' }}
                            </td>

                            <td class="px-6 py-4 whitespace-nowrap flex flex-col sm:flex-row gap-1">
                                <button
                                    class="px-3 py-1 bg-[#d4af37] text-gray-900 font-semibold rounded-md hover:bg-yellow-400 transition"
                                    data-modal-target="modal-{{ listing.id }}">
                                    Show
                                </button>
                                <a href="{{ path('app_listing_edit', {'id': listing.id}) }}"
                                   class="px-3 py-1 bg-[#d4af37] text-gray-900 font-semibold rounded-md hover:bg-yellow-400 transition">
                                   Edit
                                </a>
                            </td>
                        </tr>

                        {# === Modal for Details === #}
                        <div id="modal-{{ listing.id }}" class="fixed inset-0 bg-black bg-opacity-60 hidden flex items-center justify-center z-50 overflow-auto">
                            <div class="bg-gray-900 p-6 rounded-md w-96 relative max-h-[90vh] overflow-auto border border-[#d4af37]/30">
                                <span class="absolute top-2 right-3 cursor-pointer text-[#d4af37]" onclick="document.getElementById('modal-{{ listing.id }}').classList.add('hidden')">✕</span>
                                
                                <h2 class="text-xl font-bold text-[#d4af37] mb-3">Listing #{{ listing.id }}</h2>
                                <p class="text-gray-300 mb-2"><strong>Seller:</strong> {{ listing.user.username ?? 'Unknown' }}</p>
                                <p class="text-gray-300 mb-2"><strong>Collectible:</strong> {{ listing.collectible.name ?? 'Unknown' }}</p>
                                <p class="text-gray-300 mb-2"><strong>Grade:</strong> {{ listing.grade ?? 'N/A' }}</p>
                                <p class="text-gray-300 mb-2"><strong>Price:</strong> ₱{{ listing.price|number_format(2, '.', ',') }}</p>
                                <p class="text-gray-400 mb-2"><strong>Created:</strong> {{ listing.createdAt ? listing.createdAt|date('Y-m-d H:i:s') : 'N/A' }}</p>

                                <div class="flex justify-between mt-4 gap-2">
                                    <a href="{{ path('app_listing_edit', {'id': listing.id}) }}" 
                                       class="px-3 py-1 bg-[#d4af37] text-gray-900 rounded hover:bg-yellow-400">Edit</a>
                                    {{ include('listing/_delete_form.html.twig', {'listing': listing}) }}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <tr>
                            <td colspan="9" class="px-6 py-4 text-center text-gray-400">No listings found</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# === JS for Modals === #}
<script>
document.querySelectorAll('button[data-modal-target]').forEach(btn => {
    btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-modal-target');
        document.getElementById(target).classList.remove('hidden');
    });
});
</script>
{% endblock %}
