{% extends 'sidebar.html.twig' %}

{% block title %}Listing Management{% endblock %}

{% block body %}
<div class="crud-page-container" >
<meta name="turbo-visit-control" content="reload">
    <div class="crud-page-header">
        <h1 class="crud-page-title">Listing Management</h1>
        
        <div class="crud-page-actions">
            <a href="{{ path('app_listing_new') }}" class="crud-btn crud-btn-create">＋ New Listing</a>
        </div>
    </div>

    {# === Listings Table === #}
    <div class="crud-table-wrapper">
        <div class="crud-table-scroll">
            <table id="listingManagementTable" class="crud-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Collectible</th>
                        <th>Owner</th>
                        <th>Grade</th>
                        <th>Price</th>
                        <th>For Sale</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for listing in listings %}
                    <tr>
                        <td>{{ listing.id }}</td>
                        <td>
                            {% if listing.collectible %}
                                <div class="collectible-info">
                                    <strong>{{ listing.collectible.name }}</strong>
                                </div>
                            {% else %}
                                <span class="text-gray-400">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if listing.user %}
                                {% if listing.user.username %}
                                    <strong>{{ listing.user.username }}</strong>
                                {% else %}
                                    <span class="text-gray-400">No username</span>
                                {% endif %}
                            {% else %}
                                <span class="text-gray-400">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if listing.grade %}
                                PSA {{ listing.grade }}
                            {% else %}
                                <span class="text-gray-400">—</span>
                            {% endif %}
                        </td>
                        <td>${{ listing.price|number_format(2) }}</td>
                        <td>
                            {% if listing.isForSale %}
                                <span class="crud-badge crud-badge-active">Yes</span>
                            {% else %}
                                <span class="crud-badge crud-badge-inactive">No</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="crud-btn-group">
                                <a href="{{ path('app_listing_show', {'id': listing.id}) }}"
                                   class="crud-btn crud-btn-secondary crud-btn-small">
                                    View
                                </a>
                                <a href="{{ path('app_listing_edit', {'id': listing.id}) }}"
                                   class="crud-btn crud-btn-secondary crud-btn-small">
                                    Edit
                                </a>
                                <form method="post" 
                                      action="{{ path('app_listing_delete', {'id': listing.id}) }}" 
                                      onsubmit="return confirm('Are you sure you want to delete this listing? This action cannot be undone.');"
                                      style="display: inline; margin: 0;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ listing.id) }}">
                                    <button type="submit" class="crud-btn crud-btn-danger crud-btn-small">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}