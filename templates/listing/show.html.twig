{% extends 'base.html.twig' %}

{% block title %}Listing{% endblock %}

{% block body %}
    <h1>Listing</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ listing.id }}</td>
            </tr>
            <tr>
                <th>Grade</th>
                <td>{{ listing.grade }}</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>{{ listing.price }}</td>
            </tr>
            <tr>
                <th>Is_for_sale</th>
                <td>{{ listing.isForSale ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Is_shop_item</th>
                <td>{{ listing.isShopItem ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ listing.createdAt ? listing.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_listing_index') }}">back to list</a>

    <a href="{{ path('app_listing_edit', {'id': listing.id}) }}">edit</a>

    {{ include('listing/_delete_form.html.twig') }}
{% endblock %}
