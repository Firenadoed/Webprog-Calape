{% extends 'sidebar.html.twig' %}

{% block title %}{{ listing.collectible ? listing.collectible.name : 'Listing' }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/show.css') }}">
{% endblock %}

{% block body %}
<div class="show-container">
    <div class="show-header">
        <h1>{{ listing.collectible ? listing.collectible.name : 'Listing' }}</h1>
        <div class="show-subtitle">
            {% if listing.collectible and listing.collectible.franchise %}
                From {{ listing.collectible.franchise }}
            {% endif %}
        </div>
    </div>
    
    <div class="show-content">
        <!-- Left Column: Image -->
        <div class="show-image-section">
            {% if listing.collectible and listing.collectible.image %}
                <img src="{{ asset('uploads/collectibles/' ~ listing.collectible.image) }}" 
                     alt="{{ listing.collectible.name }}" 
                     class="show-main-image">
            {% else %}
                <div class="show-no-image">
                    📷 No Image Available
                </div>
            {% endif %}
            
        </div>
        
        <!-- Right Column: Information -->
        <div class="show-info-section">
            <div class="show-info-grid">
                <div class="show-info-item">
                    <div class="show-info-label">Listing Status</div>
                    <div class="show-status-indicator">
                        <span class="show-status-dot {{ listing.isForSale ? 'show-status-dot-active' : 'show-status-dot-inactive' }}"></span>
                        <span class="show-info-value">
                            {% if listing.isForSale %}
                                <span class="show-badge show-badge-sale">FOR SALE</span>
                            {% else %}
                                <span class="show-badge show-badge-no-sale">NOT FOR SALE</span>
                            {% endif %}
                        </span>
                    </div>
                </div>
                
                <div class="show-info-item">
                    <div class="show-info-label">Grade</div>
                    <div class="show-info-value">
                        <span class="show-badge show-badge-grade">Grade {{ listing.grade }}</span>
                    </div>
                </div>
                
                <div class="show-info-item">
                    <div class="show-info-label">Price</div>
                    <div class="show-price-display">
                        <span class="show-price-symbol">$</span>{{ listing.price|number_format(2) }}
                    </div>
                    {% if listing.isForSale %}
                        <p style="color: #a0a0a0; margin-top: 0.5rem;">This item is available for purchase</p>
                    {% else %}
                        <p style="color: #a0a0a0; margin-top: 0.5rem;">This item is not currently for sale</p>
                    {% endif %}
                </div>
                
                {% if listing.collectible %}
                    <div class="show-info-item">
                        <div class="show-info-label">Collectible Details</div>
                        <div class="show-info-value">
                            <strong>Name:</strong> {{ listing.collectible.name }}<br>
                            {% if listing.collectible.category %}
                                <strong>Category:</strong> {{ listing.collectible.category|capitalize }}<br>
                            {% endif %}
                            {% if listing.collectible.franchise %}
                                <strong>Franchise:</strong> {{ listing.collectible.franchise }}
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
                
                {% if listing.user %}
                    <div class="show-info-item">
                        <div class="show-info-label">Owner</div>
                        <div class="show-owner-info">
                            {% if listing.user.profileImage %}
                                <img src="{{ asset('uploads/profile/' ~ listing.user.profileImage) }}" 
                                     alt="{{ listing.user.username }}" 
                                     class="show-owner-avatar">
                            {% else %}
                                <div class="show-owner-avatar" style="background: #d4af37; display: flex; align-items: center; justify-content: center; color: #1a1a1a; font-weight: bold;">
                                    {{ listing.user.username|first|upper }}
                                </div>
                            {% endif %}
                            <div class="show-owner-details">
                                <h4>{{ listing.user.username }}</h4>
                                <p>Collector since {{ listing.user.createdAt ? listing.user.createdAt|date('M Y') : 'N/A' }}</p>
                            </div>
                        </div>
                    </div>
                {% endif %}
                
              
            <!-- Action Buttons -->
            <div class="show-actions">
                <a href="{{ path('app_listing_index') }}" class="show-btn show-btn-back data-turbo="false"">← Back to Listings</a>
                <a href="{{ path('app_listing_edit', {'id': listing.id}) }}" class="show-btn show-btn-edit">✏️ Edit Listing</a>
                
                <form method="post" action="{{ path('app_listing_delete', {'id': listing.id}) }}" 
                      onsubmit="return confirm('Are you sure you want to delete this listing?');" 
                      style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ listing.id) }}">
                    <button type="submit" class="show-btn show-btn-delete">🗑️ Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}