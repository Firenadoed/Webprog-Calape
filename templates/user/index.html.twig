{% extends 'sidebar.html.twig' %}

{% block title %}User Management{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/crud-components.css') }}">
{% endblock %}

{% block body %}
<div class="crud-page-container">
<meta name="turbo-visit-control" content="reload">
    <div class="crud-page-header">
        <h1 class="crud-page-title">User Management</h1>
        
        <div class="crud-page-actions">
            <a href="{{ path('app_user_new') }}" class="crud-btn crud-btn-create">＋ New User</a>
        </div>
    </div>

    {# === Users Table === #}
    <div class="crud-table-wrapper">
        <div class="crud-table-scroll">
            <table id="userManagementTable" class="crud-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Profile</th>
                        <th>Username</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th>Date Created</th>
                        <th>Actions</th> {# Changed from 8 to 7 columns #}
                    </tr>
                </thead>

                <tbody>
                    {% for user in users %}
                    <tr class="{{ loop.index is even ? 'crud-table-row-even' : 'crud-table-row-odd' }}">
                        <td data-label="ID">{{ user.id }}</td>
                        <td data-label="Profile">
                            {% if user.profileImage %}
                                <img src="{{ asset('uploads/profile/' ~ user.profileImage) }}"
                                     alt="{{ user.username }}"
                                     class="crud-avatar">
                            {% else %}
                                <span class="text-gray-400">No Image</span>
                            {% endif %}
                        </td>
                        <td data-label="Username">{{ user.username }}</td>
                        <td data-label="Roles">
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="crud-badge crud-badge-admin">Admin</span>
                            {% elseif 'ROLE_STAFF' in user.roles %}
                                <span class="crud-badge crud-badge-staff">Staff</span>
                            {% else %}
                                <span class="crud-badge crud-badge-user">User</span>
                            {% endif %}
                        </td>
                        <td data-label="Status">
                            {% if user.status == true %}
                                <span class="crud-badge crud-badge-active">Active</span>
                            {% elseif user.status == false %}
                                <span class="crud-badge crud-badge-inactive">Inactive</span>
                            {% elseif user.status is null %}
                                <span class="crud-badge crud-badge-inactive">Inactive</span>
                            {% else %}
                                <span class="crud-badge">{{ user.status }}</span>
                            {% endif %}
                        </td>
                        <td data-label="Date Created" data-order="{{ user.createdAt|date('U') }}">
                            {% if user.createdAt %}
                                <div class="text-muted small">{{ user.createdAt|date('M d, Y') }}</div>
                                <div class="text-xs text-gray-500">{{ user.createdAt|date('h:i A') }}</div>
                            {% else %}
                                <span class="text-gray-400">-</span>
                            {% endif %}
                        </td>
                        <td data-label="Actions">
                            <div class="crud-btn-group" style="display: flex; gap: 0.5rem; flex-wrap: nowrap;">
                                <a href="{{ path('app_user_edit', {'id': user.id}) }}"
                                   class="crud-btn crud-btn-secondary crud-btn-small">
                                    Edit
                                </a>
                                <form method="post" 
                                      action="{{ path('app_user_delete', {'id': user.id}) }}" 
                                      onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');"
                                      style="display: inline; margin: 0;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button type="submit" class="crud-btn crud-btn-danger crud-btn-small">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="crud-empty-state"> {# Changed from 8 to 7 #}
                            <div class="crud-empty-icon">📭</div>
                            <p>No users found</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}